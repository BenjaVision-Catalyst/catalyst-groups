{ #category : 'examples' }
CGCoreExamples >> acceptedStewardship [
 <gtExample>
 | group successor offer result |
 self setUp. group := self create.
 self assert: (self join: bob group: group) isSuccess. group := self group: group id.
 successor := self member: bob group: group.
 result := self execute: 'TransferStewardship' body: { 0 -> group id. 1 -> successor id. 2 -> successor revision. 3 -> 60000 } asDictionary actor: alice group: group.
 self assert: result isSuccess. group := self group: group id.
 self assert: (group at: #holder) equals: (self member: alice group: group) id.
 offer := (group at: #offers) values anyOne.
 result := self execute: 'AcceptStewardship' body: (self entityBody: offer group: group) actor: bob group: group.
 self assert: result isSuccess. group := self group: group id.
 self assert: (group at: #holder) equals: successor id.
 ^ group
]

