{ #category : 'examples' }
CGCoreExamples >> runtimeNamedService [
 <gtExample>
 | worker service unit request |
 self setUp.
 worker := CRWorkerQueueTestWorker new clock: clock; yourself.
 [
  service := worker services installServiceClass: CGCoreService serviceIdentifier: #groups configuration: (CRServiceConfiguration default serviceClass: CGCoreService; yourself).
  service configureDevelopmentIdentities: identities clock: clock.
  worker services startAll.
  request := self request: 'CreateGroup' body: { 0 -> 'Runtime Group'. 1 -> 'open'. 2 -> 'discoverable'. 3 -> 4 } asDictionary group: nil.
  request := CGCoreRequest operation: request operation payload: (request payload at: 1 put: service developmentGeneration; yourself).
  unit := CGCoreCommandWorkUnit new.
  unit request: request actor: alice.
  worker executeWorkUnitInEnvelope: ((CRWorkUnitEnvelope onWorkUnit: unit) serviceIdentifier: #groups; yourself).
  self assert: unit result code equals: #Success.
  ^ unit result
 ] ensure: [ worker stopAndUninstallServices ]
]

{ #category : 'fixtures' }
CGCoreExamples >> setUp [
 super setUp.
 clock := CRFixedClock atMillis: 1000.
 identities := CGDevelopmentIdentities new.
 alice := CGUserRef domain: 'catalyst' tenant: 'test' subject: 'alice'.
 bob := CGUserRef domain: 'catalyst' tenant: 'test' subject: 'bob'.
 casey := CGUserRef domain: 'catalyst' tenant: 'test' subject: 'casey'.
 { alice. bob. casey } do: [ :user | identities allow: user ].
 owner := CGCoreOwner identities: identities clock: clock
]

{ #category : 'examples' }
CGCoreExamples >> suspendedThenResumed [
 <gtExample>
 | group member result |
 self setUp. group := self create.
 self assert: (self join: bob group: group) isSuccess. group := self group: group id.
 member := self member: bob group: group.
 result := self execute: 'SuspendMember' body: (self entityBody: member group: group) actor: alice group: group.
 self assert: result isSuccess. group := self group: group id.
 member := self member: bob group: group.
 self assert: member state equals: #suspended.
 self assert: (self join: bob group: group) code equals: #GovernanceBlocked.
 result := self execute: 'ResumeMember' body: (self entityBody: member group: group) actor: alice group: group.
 self assert: result isSuccess.
 ^ self group: group id
]
