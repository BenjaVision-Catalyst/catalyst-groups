 owner failAt: #afterPublication.
 self should: [ owner execute: request actor: alice ] raise: Error.
 result := owner operation: request operationId actor: alice generation: owner generation.
 self assert: result isSuccess.
 ^ owner developmentSnapshot
]

{ #category : 'examples' }
CGCoreExamples >> rejoinedWithNewIncarnation [
 <gtExample>
 | group first result |
 self setUp. group := self create.
 self assert: (self join: bob group: group) isSuccess. group := self group: group id.
 first := self member: bob group: group.
 self assert: (self execute: 'LeaveGroup' body: (self entityBody: first group: group) actor: bob group: group) isSuccess.
 group := self group: group id. result := self join: bob group: group.
 self assert: result isSuccess. group := self group: group id.
 self deny: (self member: bob group: group) id = first id.
 self assert: ((group at: #memberships) at: first id) state equals: #left.
 ^ group
]

